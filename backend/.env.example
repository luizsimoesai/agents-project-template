# --- Application Settings ---
PROJECT_NAME=backend
VERSION="0.1.0"
DEBUG=true

# [MANDATORY] Path to the main agent configuration file
AEGRA_CONFIG=aegra.json

# --- Database ---
# Option 1: Single connection string (standard for containers/cloud)
# DATABASE_URL=postgresql://user:password@host:5432/backend
#
# Option 2: Individual fields (used when DATABASE_URL is not set)
POSTGRES_DB=backend
POSTGRES_HOST=localhost
# [REQUIRED] No default — set a strong password before starting.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_USER=backend
DB_ECHO_LOG=false

# --- Connection Pools ---
# SQLAlchemy (Metadata & App)
SQLALCHEMY_POOL_SIZE=2
SQLALCHEMY_MAX_OVERFLOW=0

# LangGraph (Agent Runtime)
LANGGRAPH_MIN_POOL_SIZE=1
LANGGRAPH_MAX_POOL_SIZE=6

# --- Authentication ---
# Aegra auth mode. `custom` enables this template's JWT handler.
# `noop` disables authentication entirely — do NOT use except in isolated dev.
AUTH_TYPE=custom

# --- JWT ---
# [REQUIRED] Must be at least 32 characters. Generate with: openssl rand -hex 32
# The app refuses to start if this is empty or matches the placeholder.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Server Configuration ---
HOST=0.0.0.0
PORT=2026
# SERVER_URL takes precedence over HOST/PORT when set.
# When unset, it is derived automatically as http://{HOST}:{PORT}.
# SERVER_URL=http://localhost:2026

# --- Logging ---
LOG_LEVEL=INFO
ENV_MODE=LOCAL # DEVELOPMENT, PRODUCTION, LOCAL (PRODUCTION outputs JSON logs)
LOG_VERBOSITY=standard # standard, verbose (verbose outputs request-id)

# --- LLM ---
# Default model used when an assistant does not specify one.
# Format: provider:model (e.g. anthropic:claude-sonnet-4-6, openai:gpt-4o-mini).
# Leave empty so `task bootstrap` selects one based on configured providers.
MODEL=
# MODEL_BASE_URL=https://litellm.example.com/v1  # optional: Ollama or proxy base URL

# --- LLM Providers ---
# Configure AT LEAST ONE. `task bootstrap` prompts and writes the values here.
# All are commented out by default so the wizard does not mistake placeholders
# for real keys. (TOGETHER_API_KEY is removed; no Together models are in the
# seed catalogue. Re-add it manually if you extend seeds/models.yaml.)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Aegra Workers (Redis) ---
REDIS_BROKER_ENABLED=false
# REDIS_URL=redis://localhost:6379
# WORKER_COUNT=3              # workers por instância
# N_JOBS_PER_WORKER=10        # tarefas simultâneas por worker
# BG_JOB_TIMEOUT_SECS=3600   # tempo máximo de execução por run (segundos)

# --- Observability (OpenTelemetry) ---
# Unified config for tracing. Supports multiple targets via Fan-out.
OTEL_SERVICE_NAME=aegra-backend
# Enable targets by comma-separated list: "LANGFUSE,PHOENIX,GENERIC"
# Leave empty to disable tracing.
OTEL_TARGETS=""
# Enable debug tracing to console (stdout)
OTEL_CONSOLE_EXPORT=false

# [Target: Langfuse]
# Note: uses LANGFUSE_BASE_URL (not HOST) to match SDK standards
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# [Target: Arize Phoenix]
# Default local endpoint shown
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_API_KEY=

# [Target: Generic OTLP]
# For Jaeger, Honeycomb, or other OTLP collectors
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example headers: "Authorization=Bearer <token>,X-Custom=Value"
OTEL_EXPORTER_OTLP_HEADERS=
